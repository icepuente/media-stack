# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit it.

# --- Identity -----------------------------------------------------------------
# The user/group that owns your data and config folders. Find yours with: id
PUID=1000
PGID=1000
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# --- Paths --------------------------------------------------------------------
# Single data tree. MUST be one filesystem for hardlinks (see README "Disk layout").
DATA_ROOT=/data
# App configuration/databases. Put this on an SSD if you can; back it up.
CONFIG_ROOT=./config
# Plex transcoder scratch space (can be a tmpfs/RAM disk or fast SSD).
TRANSCODE_DIR=./transcode

# --- Networking ---------------------------------------------------------------
# Address the web UIs are published on. 0.0.0.0 = all interfaces.
# Set to a LAN or Tailscale IP to avoid exposing UIs on other interfaces.
BIND_IP=0.0.0.0
SEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
TRANSMISSION_PORT=9091
TRANSMISSION_PEER_PORT=51413
CWA_PORT=8083
SHELFMARK_PORT=8084
# Plex uses host networking and always listens on 32400.

# --- Plex ---------------------------------------------------------------------
# One-time claim token from https://www.plex.tv/claim (expires after 4 minutes).
# Only used on the very first start; clear it afterwards.
PLEX_CLAIM=

# --- Transmission web UI / RPC login (strongly recommended) --------------------
TRANSMISSION_USER=
TRANSMISSION_PASS=

# --- Optional profiles & overrides ----------------------------------------------
# Comma-separated profiles to start with plain `docker compose up -d`:
#   books      -> Calibre-Web-Automated + Shelfmark Lite
#   unpackerr  -> extract RAR'd releases
# COMPOSE_PROFILES=books,unpackerr
#
# Extra compose files (colon-separated). Examples:
#   VPN for Transmission:  COMPOSE_FILE=docker-compose.yml:compose.vpn.yml
#   NVIDIA transcoding:    COMPOSE_FILE=docker-compose.yml:compose.nvidia.yml
#   Both:                  COMPOSE_FILE=docker-compose.yml:compose.vpn.yml:compose.nvidia.yml
# COMPOSE_FILE=docker-compose.yml

# --- API keys (fill in AFTER first boot; Settings -> General in each app) -------
# Used by unpackerr (Radarr/Sonarr) and Shelfmark (Prowlarr).
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# --- Books profile ----------------------------------------------------------------
# URL your browser uses to reach Calibre-Web-Automated (used for links in Shelfmark)
CWA_PUBLIC_URL=http://localhost:8083
# Set to true if the book library lives on NFS/SMB or a FUSE filesystem such as mergerfs
CWA_NETWORK_SHARE_MODE=false

# --- VPN override (compose.vpn.yml) ---------------------------------------------
# See https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
OPENVPN_USER=
OPENVPN_PASSWORD=
VPN_SERVER_COUNTRIES=
VPN_PORT_FORWARDING=off
# e.g. 10.0.0.0/24 (your LAN subnet) - only if tunnelled containers must reach LAN hosts
LAN_SUBNET=
